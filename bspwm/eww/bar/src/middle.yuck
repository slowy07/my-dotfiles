(defpoll datetime :interval "1s" "date '+%a %e | %H:%M'")

(defwidget time []
  (button :class "txt datetime" :halign "end"
          :onclick "eww -c ~/.config/bspwm/eww open --toggle heatmap-popup"
          datetime))

(defwidget middle []
  (box :valign "center" :halign "end" :space-evenly false
    (time)))