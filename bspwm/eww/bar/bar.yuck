(include "bar/src/left.yuck")
(include "bar/src/middle.yuck")
(include "bar/src/right.yuck")
(include "bar/src/workspaces.yuck")

(defwindow dock
		   :monitor 0
           :geometry (geometry :x "0%"
                               :y "-0.5%"
                               :width "90%"
                               :anchor "bottom center")
           :reserve (struts :side "bottom" :distance "63px")
           :windowtype "dock"
           :wm-ignore false
  (centerbox  :class "zuup"
    (left :mon "HDMI-A-0")
    (middle)
    (right)))

;; Second monitor: same full bar, but that monitor's workspaces
(defwindow dock2
		   :monitor "eDP"
           :geometry (geometry :x "0%"
                               :y "-0.5%"
                               :width "90%"
                               :anchor "bottom center")
           :reserve (struts :side "bottom" :distance "63px")
 :windowtype "dock"
             :wm-ignore false
  (centerbox :class "zuup"
    (left :mon "eDP")
    (middle)
    (right)))